```gitignore
# Virtual environment
venv/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables and secrets
.env

# IDE settings
.vscode/

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/

# Generated files
*.log

# OS files
.DS_Store
Thumbs.db

# Local database
data/business.db

# Generated reports
reports/

# Input files
data/input/*

# Processed files
data/processed/*

# Archived files
data/archive/*
!data/archive/.gitkeep

# Database backups
data/backup/*.db
```
